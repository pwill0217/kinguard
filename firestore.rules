rules_version = '2';

// Kinguard family circles.
//  - Only signed-in (non-anonymous) accounts can use circles.
//  - A circle holds at most 8 people.
//  - People join only with a valid, unexpired, unrevoked invite code.
//  - Owner > admin > member. Only the owner changes roles; owners/admins invite and remove.
//  - Alerts carry only the redacted verdict, never the message.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function me() { return request.auth.uid; }
    function circlePath(id) { return /databases/$(database)/documents/circles/$(id); }
    function memberPath(id, u) { return /databases/$(database)/documents/circles/$(id)/members/$(u); }
    function isMember(id) { return signedIn() && me() in get(circlePath(id)).data.memberUids; }
    function roleOf(id, u) { return get(memberPath(id, u)).data.role; }
    function isManager(id) { return isMember(id) && roleOf(id, me()) in ['owner', 'admin']; }
    function isOwner(id) { return isMember(id) && get(circlePath(id)).data.ownerUid == me(); }
    function validName(n, max) { return n is string && n.size() > 0 && n.size() <= max; }

    match /users/{userId} {
      allow read, write: if signedIn() && me() == userId;
    }

    match /invites/{code} {
      // Knowing the code is what lets you see the invite (to preview "Join the Hill family").
      allow get: if signedIn();
      allow list: if signedIn() && isMember(resource.data.circleId);
      allow create: if signedIn()
        && code.size() == 6
        && isManager(request.resource.data.circleId)
        && request.resource.data.keys().hasOnly(['circleId', 'circleName', 'createdBy', 'createdByName', 'asProtected', 'expiresAt', 'revoked', 'createdAt'])
        && request.resource.data.createdBy == me()
        && request.resource.data.revoked == false
        && request.resource.data.asProtected is bool
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(49, 'h')
        && get(circlePath(request.resource.data.circleId)).data.memberUids.size() < 8;
      allow update: if signedIn()
        && isManager(resource.data.circleId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true;
      allow delete: if false;
    }

    match /circles/{circleId} {
      function newUids() { return request.resource.data.memberUids; }
      function oldUids() { return resource.data.memberUids; }
      function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

      function renameOk() {
        return onlyChanged(['name']) && isManager(circleId) && validName(request.resource.data.name, 40);
      }
      // Join: add exactly yourself, stay within 8; the member-doc rule checks the invite.
      function joinOk() {
        return onlyChanged(['memberUids'])
          && newUids().size() == oldUids().size() + 1
          && newUids().hasAll(oldUids())
          && me() in newUids()
          && !(me() in oldUids())
          && newUids().size() <= 8
          && existsAfter(memberPath(circleId, me()));
      }
      function removed() { return oldUids().removeAll(newUids()); }
      // Leave or remove: drop exactly one non-owner, whose member doc is deleted in the same batch.
      function removeOk() {
        return onlyChanged(['memberUids'])
          && newUids().size() == oldUids().size() - 1
          && oldUids().hasAll(newUids())
          && removed().size() == 1
          && removed()[0] != resource.data.ownerUid
          && (removed()[0] == me() || isManager(circleId))
          && !existsAfter(memberPath(circleId, removed()[0]));
      }

      allow get, list: if signedIn() && me() in resource.data.memberUids;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'memberUids', 'createdAt'])
        && request.resource.data.ownerUid == me()
        && request.resource.data.memberUids == [me()]
        && validName(request.resource.data.name, 40)
        && existsAfter(memberPath(circleId, me()));
      allow update: if signedIn() && (renameOk() || joinOk() || removeOk());
      allow delete: if signedIn() && resource.data.ownerUid == me();

      match /members/{memberId} {
        function data() { return request.resource.data; }
        function ownerCreate() {
          return !exists(circlePath(circleId))
            && getAfter(circlePath(circleId)).data.ownerUid == me()
            && data().keys().hasOnly(['name', 'photoURL', 'role', 'protected', 'joinedAt', 'lastCheck'])
            && data().role == 'owner';
        }
        function inviteOk(inv) {
          return inv.circleId == circleId
            && inv.revoked == false
            && inv.expiresAt > request.time
            && data().protected == inv.asProtected;
        }
        function inviteJoin() {
          return data().keys().hasOnly(['name', 'photoURL', 'role', 'protected', 'joinedAt', 'lastCheck', 'inviteCode'])
            && data().role == 'member'
            && data().inviteCode is string
            && inviteOk(get(/databases/$(database)/documents/invites/$(data().inviteCode)).data)
            && me() in getAfter(circlePath(circleId)).data.memberUids;
        }
        function selfUpdateOk() {
          return memberId == me()
            && data().diff(resource.data).affectedKeys().hasOnly(['lastCheck', 'name', 'photoURL', 'protected'])
            && data().role == resource.data.role
            && (data().lastCheck == null || data().lastCheck.verdict in ['safe', 'suspicious', 'likely_scam']);
        }
        function managerUpdateOk() {
          return isManager(circleId)
            && data().diff(resource.data).affectedKeys().hasOnly(['protected', 'role'])
            && (data().role == resource.data.role
                || (isOwner(circleId) && resource.data.role != 'owner' && data().role in ['admin', 'member']));
        }

        allow read: if isMember(circleId);
        allow create: if signedIn()
          && memberId == me()
          && validName(data().name, 60)
          && data().protected is bool
          && data().lastCheck == null
          && (ownerCreate() || inviteJoin());
        allow update: if signedIn() && (selfUpdateOk() || managerUpdateOk());
        allow delete: if signedIn()
          && resource.data.role != 'owner'
          && (memberId == me()
              || (isManager(circleId) && (roleOf(circleId, me()) == 'owner' || resource.data.role == 'member')));
      }

      match /alerts/{alertId} {
        allow read: if isMember(circleId);
        allow create: if isMember(circleId)
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'verdict', 'riskScore', 'category',
                                                    'headline', 'explanation', 'createdAt', 'ackBy', 'ackNames'])
          && request.resource.data.fromUid == me()
          && request.resource.data.verdict in ['safe', 'suspicious', 'likely_scam']
          && request.resource.data.riskScore is int
          && validName(request.resource.data.fromName, 40)
          && validName(request.resource.data.headline, 200)
          && request.resource.data.explanation is string && request.resource.data.explanation.size() <= 1000
          && request.resource.data.ackBy == [] && request.resource.data.ackNames == []
          && request.resource.data.createdAt == request.time;
        allow update: if isMember(circleId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackBy', 'ackNames'])
          && me() in request.resource.data.ackBy;
        allow delete: if false;
      }
    }
  }
}
