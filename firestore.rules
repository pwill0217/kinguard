rules_version = '2';

// Kinguard: family circles. Alerts only ever contain the redacted verdict,
// never the original message or personal details.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function circle(code) { return get(/databases/$(database)/documents/circles/$(code)).data; }
    function isMember(code) { return signedIn() && request.auth.uid in circle(code).members; }

    match /circles/{code} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && code.size() == 6
        && request.resource.data.keys().hasOnly(['createdBy', 'members', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // Joining: the only allowed change is adding yourself to members.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() < 12;

      allow delete: if false;

      match /alerts/{alertId} {
        allow read: if isMember(code);

        allow create: if isMember(code)
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'verdict', 'riskScore', 'category',
                                                    'headline', 'explanation', 'createdAt', 'ackBy', 'ackNames'])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.verdict in ['safe', 'suspicious', 'likely_scam']
          && request.resource.data.riskScore is int
          && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 40
          && request.resource.data.headline is string && request.resource.data.headline.size() <= 200
          && request.resource.data.explanation is string && request.resource.data.explanation.size() <= 1000
          && request.resource.data.ackBy == [] && request.resource.data.ackNames == []
          && request.resource.data.createdAt == request.time;

        // Helpers can mark "I'm on it".
        allow update: if isMember(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackBy', 'ackNames'])
          && request.auth.uid in request.resource.data.ackBy;

        allow delete: if false;
      }
    }
  }
}
