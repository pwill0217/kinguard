# Firebase web app config (Firebase console > Project settings > Your apps > Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (required by Firebase AI Logic). Use ONE of:
#  - reCAPTCHA Enterprise site key (recommended for the hosted build)
VITE_RECAPTCHA_ENTERPRISE_KEY=
#  - or reCAPTCHA v3 site key
VITE_RECAPTCHA_V3_KEY=
#  - Debug provider for local development: "true" prints a token in the console to register,
#    or paste a token you already registered in the Firebase console.
VITE_APPCHECK_DEBUG_TOKEN=
